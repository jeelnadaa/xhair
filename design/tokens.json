{
  "$schema": "https://json.schemastore.org/design-tokens",
  "name": "XHAIR Design System Tokens v5",
  "version": "5.0.0",
  "color": {
    "ramps": {
      "graphite": {
        "bg": { "value": "#0A0A0A", "type": "color", "description": "App chrome background" },
        "canvas": { "value": "#080808", "type": "color", "description": "Editor grid canvas background" },
        "surface": { "value": "#111111", "type": "color", "description": "Sidebar, panels, header container" },
