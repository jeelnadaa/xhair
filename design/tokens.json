        "hover": { "value": "#1F1F1F", "type": "color", "description": "Hovered items, list selections" },
        "border": { "value": "#262626", "type": "color", "description": "Subtle 1px panel and item borders" },
        "borderStrong": { "value": "#3A3A3A", "type": "color", "description": "Hover and active borders" },
        "text": { "value": "#EDEDED", "type": "color", "description": "Primary high-contrast text" },
        "textMuted": { "value": "#A0A0A0", "type": "color", "description": "Secondary helper and label text" },
        "textDim": { "value": "#808080", "type": "color", "description": "Tertiary readouts and disabled text" },
        "gridMinor": { "value": "#141414", "type": "color", "description": "1px grid subdivisions" },
        "gridMajor": { "value": "#1E1E1E", "type": "color", "description": "5px and 10px major grid ticks" }
