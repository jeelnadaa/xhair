  "typography": {
    "fontPacks": {
      "satoshi": {
        "name": "Satoshi (Default)",
        "display": "'Clash Display', 'Satoshi', sans-serif",
        "ui": "'Satoshi', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
        "mono": "'JetBrains Mono', Consolas, monospace",
        "license": "Fontshare Free / OFL"
      },
      "technical": {
        "name": "Technical",
        "display": "'Geist', sans-serif",
        "ui": "'Geist', sans-serif",
        "mono": "'Geist Mono', monospace",
        "license": "OFL"
      },
      "editorial": {
        "name": "Editorial",
        "display": "'Cabinet Grotesk', sans-serif",
        "ui": "'General Sans', sans-serif",
        "mono": "'IBM Plex Mono', monospace",
        "license": "Fontshare / OFL"
      },
      "plex": {
        "name": "Plex",
        "display": "'IBM Plex Sans Condensed', sans-serif",
        "ui": "'IBM Plex Sans', sans-serif",
        "mono": "'IBM Plex Mono', monospace",
        "license": "OFL"
      },
      "space": {
        "name": "Space",
        "display": "'Space Grotesk', sans-serif",
        "ui": "'Space Grotesk', sans-serif",
        "mono": "'Space Mono', monospace",
        "license": "OFL"
      },
      "system": {
        "name": "System Native",
        "display": "'Segoe UI Variable Display', 'Segoe UI', sans-serif",
        "ui": "'Segoe UI Variable Text', 'Segoe UI', sans-serif",
        "mono": "'Cascadia Mono', Consolas, monospace",
        "license": "System Built-in"
      }
    },
    "fontSize": {
      "micro": "9px",
      "badge": "10px",
      "caption": "11px",
      "monoInput": "12px",
      "body": "13px",
      "title": "14px",
      "sectionHeader": "16px",
      "modalHeader": "18px",
      "display": "22px"
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "letterSpacing": {
      "tight": "-0.01em",
      "normal": "0",
      "label": "0.06em",
      "brand": "0.12em"
    }
  },
  "cornerStyles": {
    "sharp": {
      "none": "0px",
      "xs": "1px",
      "sm": "2px",
      "md": "2px",
      "lg": "3px",
      "xl": "4px"
    },
    "default": {
      "none": "0px",
      "xs": "2px",
      "sm": "3px",
      "md": "4px",
      "lg": "6px",
      "xl": "8px"
    },
    "soft": {
      "none": "0px",
      "xs": "3px",
      "sm": "4px",
      "md": "5px",
      "lg": "6px",
      "xl": "8px",
      "xxl": "10px"
    }
  },
  "spacing": {
    "none": "0px",
    "2xs": "2px",
    "xs": "4px",
    "sm": "6px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "2xl": "24px",
    "3xl": "32px",
    "gridBase": "8px"
  },
  "elevation": {
    "flat": "none",
    "subtle": "0 2px 8px rgba(0, 0, 0, 0.4)",
    "floating": "0 8px 24px rgba(0, 0, 0, 0.6)",
    "modal": "0 16px 48px rgba(0, 0, 0, 0.75)"
  },
  "motion": {
    "fadeDuration": "100ms",
    "themeCrossfade": "150ms",
    "slideDuration": "150ms",
    "easing": "cubic-bezier(0.16, 1, 0.3, 1)"
  }
}
